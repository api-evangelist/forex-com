        {
          "id": "2481a0ea-46b9-40e8-805a-18485f624f66",
          "name": "Place a new market trade order",
          "request": {
            "name": "Place a new market trade order",
            "description": {
              "content": "Place a new market price trade order on the FOREX.com platform. Executes immediately at the current market bid/ask price. Supports configurable direction (buy/sell), quantity, stop-loss, take-profit, and price tolerance for slippage control.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "order",
                "newtradeorder"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Direction\": \"<string>\",\n  \"MarketId\": \"<integer>\",\n  \"Quantity\": \"<double>\",\n  \"TradingAccountId\": \"<integer>\",\n  \"OfferPrice\": \"<double>\",\n  \"MarketName\": \"<string>\",\n  \"PriceTolerance\": 10,\n  \"IfDone\": [\n    {\n      \"Stop\": {\n        \"TriggerPrice\": \"<double>\",\n        \"Direction\": \"<string>\",\n        \"Quantity\": \"<double>\"\n      },\n      \"Limit\": {\n        \"TriggerPrice\": \"<double>\",\n        \"Direction\": \"<string>\",\n        \"Quantity\": \"<double>\"\n      }\n    },\n    {\n      \"Stop\": {\n        \"TriggerPrice\": \"<double>\",\n        \"Direction\": \"<string>\",\n        \"Quantity\": \"<double>\"\n      },\n      \"Limit\": {\n        \"TriggerPrice\": \"<double>\",\n        \"Direction\": \"<string>\",\n        \"Quantity\": \"<double>\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
