                  "raw": "{\n  \"Direction\": \"buy\",\n  \"MarketId\": 400616380,\n  \"Quantity\": 10000,\n  \"MarketName\": \"EUR/USD\",\n  \"TradingAccountId\": 12345678,\n  \"OfferPrice\": 1.08532,\n  \"PriceTolerance\": 10,\n  \"IfDone\": [\n    {\n      \"Stop\": {\n        \"TriggerPrice\": 1.075,\n        \"Direction\": \"sell\",\n        \"Quantity\": 10000\n      },\n      \"Limit\": {\n        \"TriggerPrice\": 1.095,\n        \"Direction\": \"sell\",\n        \"Quantity\": 10000\n      }\n    }\n  ]\n}",
