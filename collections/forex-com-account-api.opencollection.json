{
  "opencollection": "1.0.0",
  "info": {
    "name": "FOREX.com REST Account API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Session",
      "value": "{{Session}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get client and trading account details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ciapi.cityindex.com/TradingAPI/UserAccount/ClientAndTradingAccount"
          },
          "docs": "Retrieve client and trading account details including TradingAccountId, account balance, available margin, and personal account information. The TradingAccountId is required for all order and position operations."
        }
      ]
    }
  ],
  "bundled": true
}