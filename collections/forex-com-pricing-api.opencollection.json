          "http": {
            "method": "GET",
            "url": "https://ciapi.cityindex.com/TradingAPI/market/:marketId/barhistorybefore",
            "params": [
              {
                "name": "marketId",
                "value": "",
                "type": "path",
                "description": "Market ID for the instrument"
              },
              {
                "name": "interval",
                "value": "",
                "type": "query",
                "description": "Bar interval type"
              },
              {
                "name": "span",
                "value": "",
                "type": "query",
                "description": "Interval span"
              },
              {
